<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width">
		<title>{{ title }} | {{ metadata.title }}</title>
		<link rel="icon" href={{"/cap.svg" | plainUrl }} type="image/svg+xml">
		<style>
			:root {
				color-scheme: light dark;
			}
			html {
				font: 1rem/1.5 monospace;
			}
			body {
				max-width: 80ch;
				margin: 0 auto;
				padding: 1rem 1ch;
				overflow-wrap: break-word;
			}
			h1,
			h2,
			h3,
			h4,
			h5,
			h6 {
				font-size: inherit;
				margin: 1.5em 0 0.5em;
			}
			footer,
			header {
				text-align: center;
			}
			code,
			kbd,
			pre,
			samp {
				font: inherit;
			}
			pre {
				overflow-x: auto;
				padding: 0.75em 1ch;
			}
			code {
				padding: 0.1em 0.3ch;
			}
			pre code {
				background: none;
				padding: 0;
			}
			ul {
				padding-left: 3ch;
				list-style: disc;
				list-style: "- ";
			}
			blockquote {
				margin: 1em 0 1em 2ch;
			}
			blockquote > p::before {
				content: "> ";
			}
			table {
				border-collapse: collapse;
			}
			td,
			th {
				border: 1px solid;
				padding: 0 1ch;
				text-align: left;
			}
			.scroll {
				overflow-x: auto;
			}
			nav ul {
				display: inline;
				margin: 0;
				padding: 0;
				list-style: none;
			}
			nav li {
				display: inline;
			}
			.rule {
				overflow: hidden;
				white-space: nowrap;
				margin: 1rem 0;
			}
			.skip:not(:focus) {
				position: absolute;
				left: -9999px;
			}
			iframe,
			img,
			video {
				max-width: 100%;
				margin-inline: auto;
				display: block;
			}
			dd {
				margin-bottom: 1.5rem;
			}
		</style>
	</head>

	<body>
		<header>
			<p>
				<a href="{{ "/" | plainUrl }}">{{ metadata.title }}</a>
			</p>
			<nav>
				<ul>
					<li>
						<a href={{ "/posts/" | plainUrl }}>Posts</a>
					</li>
					|
					<li>
						<a href={{ "/about/" | plainUrl }}>About</a>
					</li>
					|
					<li>
						<a href={{ "/contact/" | plainUrl }}>Contact</a>
					</li>
				</ul>
			</nav>
		</header>

		<div class="rule" aria-hidden="true">{% rule %}</div>

		<main>
			{{ content | plaintextHtml | asciiPunct | safe }}
		</main>

		<div class="rule" aria-hidden="true">{% rule %}</div>

		<footer>
			<p>(c) {{ currentYear }}
				<a href="https://gary.place">gary.place</a> |
				<a href="mailto:webmaster@gary.place">contact</a>
			</p>
		</footer>
	</body>
</html>