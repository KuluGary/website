<p>Welcome! This is a plain text mirror of <a href="https://gary.place">gary.place</a>. This website is a patchwork of interests ranging from technology, art, literature and entertainment. Please look around and see if you find anything that catches your eye.</p>

<ul>
	<li>
		<a href={{ "/posts/" | plainUrl }}>Posts</a>
	</li>
	<li>
		<a href={{ "/about/" | plainUrl }}>About</a>
	</li>
	<li>
		<a href={{ "/contact/" | plainUrl }}>Contact</a>
	</li>
</ul>

<h2>Recent updates</h2>

<ul>
	{% for post in collections.posts | limit(5) %}
		<li>
			<time datetime="{{ post.date }}">{{ post.date | formatDate("yyyy-MM-dd") }}:</time>
			<a href="{{ post.url | replace('/blog/', '/post/') | replace("/journal/", "/post/") | plainUrl }}">
				{{ post.data.title }}
			</a>
		</li>
	{% endfor %}
</ul>

