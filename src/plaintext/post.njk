---
pagination:
  data: collections.posts
  size: 1
  alias: post

permalink: "{{ plainRoot }}/post/{{ post.fileSlug }}/"

layout: plaintext.njk

eleventyComputed:
  title: "{{ post.data.title }}"
  date: "{{ post.date }}"

plaintext: true
---

<article>
  <h1>{{ title }}</h1>

  <span>
    <time datetime="{{ date | formatDate("yyyy-MM-dd") }}">
      {{ date | formatDate("yyyy-MM-dd") }}
    </time>
  </span>

  <span> | </span>

  <span>
    {{ post.data.tags | join(", ") }}
  </span>

  <p>Original: <a href="{{ metadata.url }}{{ post.url }}">
      {{ metadata.url }}{{ post.url }}
    </a>
  </p>

  <div class="rule" aria-hidden="true">{% rule "-" %}</div>

  {{ post.templateContent | safe }}
</article>